# Copy to .env and change the values. .env is not committed.
# Avoid @ : / % in the password (or URL-encode them): it is placed inside DATABASE_URL.
POSTGRES_USER=inspection
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inspection_trace
POSTGRES_PORT=5432
APP_PORT=8000

# Used when running uvicorn / alembic / pytest on the host (outside Docker).
# Inside Docker, compose.yaml builds its own DATABASE_URL pointing to the "db" service.
DATABASE_URL=postgresql+psycopg://inspection:change-me@127.0.0.1:5432/inspection_trace
